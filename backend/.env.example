# Django environment variables — copy to .env and adjust for your setup

DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1

# Database (leave empty to use SQLite)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=

# CORS — Next.js dev server
CORS_ALLOWED_ORIGINS=http://localhost:3000 http://127.0.0.1:3000

# Path to the fine-tuned SPLADE model checkpoint (relative or absolute path,
# or a Hugging Face model ID).  Leave empty to use the public base model.
SPLADE_MODEL_PATH=naver/splade-cocondenser-selfdistil
