# SQLite database file path.
# Use sqlite::memory: for ephemeral in-memory storage (testing only).
DATABASE_URL=sqlite://./supplement_buddy.db

# HTTP server bind address and port (default: 0.0.0.0:8001)
HOST=0.0.0.0
PORT=8001

# CORS allowed origins — space-separated.
# Leave empty to allow all origins (permissive mode).
CORS_ALLOWED_ORIGINS=http://localhost:3000 http://127.0.0.1:3000

# Log level: error | warn | info | debug | trace
RUST_LOG=info
